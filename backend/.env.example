# Database
DATABASE_URL=postgresql+asyncpg://dvd:dvd@localhost:5432/dvd

# App
CORS_ORIGINS=http://localhost:5173
ENV=development
LOG_LEVEL=INFO

# AIS
AISSTREAM_API_KEY=test

# Retain data for 2 days. SAR passes are 1-2 days
AIS_RETENTION_DAYS=2
VESSEL_ACTIVE_MINUTES=30
SOURCE_STALE_AFTER_SECONDS=60

CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# SAR analysis pipeline
ANALYSIS_API_KEY=
MODEL_PATH=models/sar_ship.pt
DETECTION_CONF_THRESHOLD=0.25

# Detection flagged on this distance (m)
FUSION_MAX_DISTANCE_M=500
FUSION_MAX_TIME_DELTA_HOURS=2

# Seaward metres added to the coastline when masking detections (0 = strictly
# on land). Widening it starts masking berthed and anchored vessels. Retuning is
# free — scripts/load_land.py re-flags stored detections at 0 PU.
LAND_MASK_BUFFER_M=0
