# Database
# Native dev: localhost:5432
# Docker Compose overrides this to db:5432 via the environment: block in compose
DATABASE_URL=postgresql+asyncpg://dvd:dvd@localhost:5432/dvd

# App
CORS_ORIGINS=http://localhost:5173
ENV=development
LOG_LEVEL=INFO

# AIS
AISSTREAM_API_KEY=
# Rolling history window (days). Older AIS rows are pruned hourly.
AIS_RETENTION_DAYS=7
# Window for considering a vessel "active" in the ROI (minutes). Used by /api/vessels and /api/vessels/count.
VESSEL_ACTIVE_MINUTES=30

# Optical imagery
PLANET_API_KEY=
