# --- Database ---
# Native dev: localhost:5432
# Docker Compose overrides this to db:5432 via the environment: block in compose
DATABASE_URL=postgresql+asyncpg://dvd:dvd@localhost:5432/dvd

# --- App ---
CORS_ORIGINS=http://localhost:5173
ENV=development
LOG_LEVEL=INFO

# --- AIS (weeks 1-3) ---
# Free — sign up at aisstream.io with GitHub to get a key
AISSTREAM_API_KEY=
# ROI to subscribe to. Must match a key in backend/app/rois.py.
ACTIVE_ROI=south_china_sea
# Rolling history window (days). Older AIS rows are pruned hourly.
AIS_RETENTION_DAYS=7
# Window for considering a vessel "active" in the ROI (minutes). Used by /api/vessels and /api/vessels/count.
VESSEL_ACTIVE_MINUTES=30

# --- Optical imagery ---
# Sentinel-2 via Copernicus Data Space Ecosystem (interim — free)
# Register at dataspace.copernicus.eu → User Settings → OAuth Clients
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Planet Labs PlanetScope (primary — pending access approval)
# Will take priority over Sentinel-2 when set
PLANET_API_KEY=
