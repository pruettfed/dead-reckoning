# Database
DATABASE_URL=postgresql+asyncpg://dvd:dvd@localhost:5432/dvd

# App
# Only load-bearing if the SPA is served from a different origin. The production
# image serves it from this one, so there are no cross-origin requests at all.
CORS_ORIGINS=http://localhost:5173
# development | staging | production. Defaults to production when unset
ENV=development
LOG_LEVEL=INFO
# Comma-separated Host header allow-list. Empty disables the check; set it in
# production to the deployed hostname.
ALLOWED_HOSTS=

# Developer tools. ENV=production refuses to boot with these enabled.
# A short or missing key silently disables the router rather than failing;
# ANALYSIS_API_KEY, by contrast, must be >=32 chars whenever it is set.
DEVTOOLS_ENABLED=true
DEVTOOLS_API_KEY=

# AIS
AISSTREAM_API_KEY=

# SAR passes are 1-2 days apart, so 2 days covers a fusion window with room
# to spare. Each extra day is roughly 500 MB of AIS on the volume.
AIS_RETENTION_DAYS=2
VESSEL_ACTIVE_MINUTES=240
SOURCE_STALE_AFTER_SECONDS=60

CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# SAR analysis pipeline
ANALYSIS_API_KEY=
MODEL_PATH=models/sar_ship.pt
DETECTION_CONF_THRESHOLD=0.1

# Automatic analysis scheduler
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=900
PU_MONTHLY_CEILING=25000

# AIS buffer depth required before the first sweep. A fresh database has no AIS,
# and survey ROIs have no AIS gate of their own, so without this a cold deploy
# buys pixels for six regions while every fused region is still refusing.
# Measured against the oldest fix in the database, so a redeploy onto a
# populated one starts immediately. docker-compose sets 0 for local dev.
SCHEDULER_WARMUP_HOURS=6
# Cap on that wait: with no AISSTREAM_API_KEY the buffer never fills, and survey
# regions are correct without it.
SCHEDULER_WARMUP_MAX_HOURS=8

# How long the AIS buffer must have before a scene before it may be fused.
FUSION_MAX_TIME_DELTA_HOURS=2

# Fusion by dead reckoning — measured defaults
AIS_FIX_MAX_AGE_S=1800
MATCH_RADIUS_M=200
SAR_AZIMUTH_SHIFT_S=90
DR_COURSE_ERR_FRAC=0.25

# Above this false-match rate, dark calls are withheld as indeterminate.
MAX_CHANCE_MATCH_RATE=0.10

# Seaward metres added to the coastline when masking. 0 masks only what is
# strictly on land; widening it starts eating berthed and anchored vessels.
LAND_MASK_BUFFER_M=0
