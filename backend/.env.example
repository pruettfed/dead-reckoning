# Database
# Native dev: localhost:5432
# Docker Compose overrides this to db:5432 via the environment: block in compose
DATABASE_URL=postgresql+asyncpg://dvd:dvd@localhost:5432/dvd

# App
CORS_ORIGINS=http://localhost:5173
ENV=development
LOG_LEVEL=INFO

# AIS
AISSTREAM_API_KEY=
# Rolling history window (days). Older AIS rows are pruned hourly. Detection is
# single-snapshot correlation at each SAR pass (~daily per ROI), so 2 days
# comfortably brackets every pass + SAR latency + UI tracks.
AIS_RETENTION_DAYS=2
# Window for considering a vessel "active" in the ROI (minutes). Used by /api/vessels and /api/vessels/count.
VESSEL_ACTIVE_MINUTES=30
# Seconds without a message before a connected source is reported as "stale" in /api/health.
SOURCE_STALE_AFTER_SECONDS=60

# SAR imagery — Sentinel-1 via Copernicus Data Space Ecosystem (CDSE).
# OAuth2 client credentials from dataspace.copernicus.eu. Catalog search is free;
# only pixel fetch spends Processing Units (budget: 30,000 PU/month).
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
