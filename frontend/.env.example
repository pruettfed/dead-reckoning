# Vite dev server proxy target — native dev only.
# Docker Compose sets this via the environment: block instead.
# In production (Vercel), /api/* is rewritten to the Railway backend URL via vercel.json.
VITE_API_PROXY_TARGET=http://localhost:8000

# DEV ONLY: when set, the UI shows a "Run analysis" button that sends this value
# as X-Analysis-Key. NEVER set this in a deployed build — Vite bakes env vars
# into the public JS bundle, which would hand every visitor your PU budget.
VITE_ANALYSIS_API_KEY=
